{
  "name": "lcobot",
  "version": "1.0.0",
  "description": "LCO Bot - menú de colores configurable",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/index.js",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "preinstall": "node scripts/ensurePnpm.js",
    "start": "node src/index.js",
    "dev": "node --watch-path=src/index.js --watch-path=src/events --watch-path=config/default.json --watch-path=package.json --watch-path=.env --watch-preserve-output src/index.js",
    "watch": "node src/index.js",
    "build:release": "node scripts/buildRelease.js",
    "test": "node --test --test-concurrency=1 \"src/**/__tests__/*.test.js\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
