{
  "name": "lcobot",
  "version": "1.0.0",
  "description": "LCO Bot - menú de colores configurable",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src/commands --watch-path=src/events --watch-path=src/services --watch-path=src/utils --watch-path=src/constants --watch-path=src/loaders --watch-path=src/index.js --watch-preserve-output src/index.js",
    "watch": "node --watch-path=src --watch-preserve-output src/index.js",
    "test": "node --test \"src/utils/__tests__/*.test.js\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.81",
    "canvas": "^3.2.0",
    "discord.js": "^14.11.0",
    "dotenv": "^16.4.5",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
