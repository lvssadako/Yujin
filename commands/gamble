        u.gambleStats.wins = (u.gambleStats.wins || 0) + 1;
        resultEmbed = new EmbedBuilder()
          .setColor(0x43b581)
          .setTitle('🎰 Slots - ¡GANASTE!')
          .setDescription(`${lines}\n\n💰 Ganancia: **+${profit} 🪙**\n*(rake ${Math.round(RAKE * 100)}%)*`);
      } else {
        u.gambleStats.losses = (u.gambleStats.losses || 0) + 1;
        u.gambleStats.lossesToday = (u.gambleStats.lossesToday || 0) + bet;
        resultEmbed = new EmbedBuilder()
          .setColor(0xdd2e44)
          .setTitle('🎰 Slots - Perdiste')
          .setDescription(`${lines}\n\n💸 Perdiste: **-${bet} 🪙**`);
      }
    }

    if (sub === 'crash') {
      const target = interaction.options.getNumber('objetivo'); // ej: 2.5x
      // Crash point aleatorio
      const rand = Math.random();
      const crashPoint = Math.max(1.0, 1 / (1 - rand));
      const actualCrash = Math.min(100, Math.round(crashPoint * 100) / 100);
      const won = target <= actualCrash;

      // Animación ascendente
      const frames = [1.0, 1.2, 1.5, 1.8, 2.0, 2.5, 3.0, 4.0, 5.0, 10.0];
      const relevantFrames = frames.filter(f => f <= Math.max(target, actualCrash) + 0.5);

      const animEmbed = new EmbedBuilder()
        .setColor(0xffc107)
        .setTitle('💥 Crash')
        .setDescription('🚀 Despegando...\n**1.00x**')
        .setFooter({ text: `Apuesta: ${bet} 🪙 | Objetivo: ${target.toFixed(2)}x` });
      await interaction.editReply({ embeds: [animEmbed] });

      for (const frame of relevantFrames) {
        if (frame > actualCrash) break;
        await new Promise(r => setTimeout(r, 400));
        const color = frame >= target ? 0x43b581 : 0xffc107;
        animEmbed.setColor(color).setDescription(`🚀 Subiendo...\n**${frame.toFixed(2)}x**`);
        await interaction.editReply({ embeds: [animEmbed] });
      }

      await new Promise(r => setTimeout(r, 600));

      if (won) {
        const gross = Math.floor(bet * target);
        const profit = Math.floor(gross * (1 - RAKE));
        addCoins(guildId, userId, profit);
        u.gambleStats.wins = (u.gambleStats.wins || 0) + 1;
        resultEmbed = new EmbedBuilder()
          .setColor(0x43b581)
          .setTitle('💥 Crash - ¡GANASTE!')
          .setDescription(
            `🎯 Tu objetivo: **${target.toFixed(2)}x**\n` +
            `💥 Explotó en: **${actualCrash.toFixed(2)}x**\n\n` +
            `💰 Ganancia: **+${profit} 🪙**\n` +
            `*(rake ${Math.round(RAKE * 100)}%)*`
          );
      } else {
        u.gambleStats.losses = (u.gambleStats.losses || 0) + 1;
        u.gambleStats.lossesToday = (u.gambleStats.lossesToday || 0) + bet;
        resultEmbed = new EmbedBuilder()
          .setColor(0xdd2e44)
          .setTitle('💥 Crash - Explotó antes')
          .setDescription(
            `🎯 Tu objetivo: **${target.toFixed(2)}x**\n` +
            `💥 Explotó en: **${actualCrash.toFixed(2)}x**\n\n` +
            `💸 Perdiste: **-${bet} 🪙**`
          );
      }
    }

    // Post juego: persistencia y salida
    u.gambleStats.lastAt = now;
    writeProfiles(profiles);

    const bal = getBalance(guildId, userId).coins;
    if (resultEmbed) {
      resultEmbed.addFields(
        { name: 'Balance', value: `${bal} 🪙`, inline: true },
        { name: 'Límite pérdidas hoy', value: `${Math.max(0, DAILY_LOSS_CAP - (u.gambleStats.lossesToday || 0))} 🪙`, inline: true }
      ).setFooter({ text: `CD: ${Math.floor(COOLDOWN_MS / 1000)}s • Rake: ${Math.round(RAKE * 100)}%` });
      return interaction.editReply({ embeds: [resultEmbed] });
    }

    return interaction.editReply('❌ Error interno.');
  },

  async executePrefix(message, args, client) {
    if (!message.guild || !message.member) {
      return message.reply('❌ Este comando solo puede usarse en servidores.');
    }

    const sub = (args[0] || '').toLowerCase();

    // --- Stats (puede ser de otro usuario) ---
    if (sub === 'stats') {
      let targetUser = message.author;
      if (message.mentions.users.size > 0) {
        targetUser = message.mentions.users.first();
      } else if (args.length > 1) {
        const arg = args[1].replace(/[<@!>]/g, '');
        let user = message.guild.members.cache.get(arg)?.user;
        if (!user) {
          user = message.guild.members.cache.find(m =>
            m.user.username.toLowerCase() === arg.toLowerCase() ||
            m.user.tag.toLowerCase() === arg.toLowerCase()
          )?.user;
        }
        if (user) targetUser = user;
      }
      const profiles = readProfiles();
      const u = ensureUser(profiles, message.guild.id, targetUser.id);
      if (!u.gambleStats) u.gambleStats = { wins: 0, losses: 0, lossesToday: 0 };
      const stats = u.gambleStats;
      const total = (stats.wins || 0) + (stats.losses || 0);
      const winrate = total > 0 ? ((stats.wins / total) * 100).toFixed(1) : '0.0';

      const statsEmbed = new EmbedBuilder()
        .setColor(0x2b2d31)
        .setTitle(`📊 Estadísticas de Gambling de ${targetUser.username}`)
        .addFields(
          { name: '✅ Victorias', value: String(stats.wins || 0), inline: true },
          { name: '❌ Derrotas', value: String(stats.losses || 0), inline: true },
          { name: '📈 Winrate', value: `${winrate}%`, inline: true },
          { name: '💸 Pérdidas hoy', value: `${stats.lossesToday || 0} 🪙`, inline: true },
          { name: '🚫 Límite restante', value: `${Math.max(0, DAILY_LOSS_CAP - (stats.lossesToday || 0))} 🪙`, inline: true }
        )
        .setFooter({ text: `Límite diario: ${DAILY_LOSS_CAP} 🪙 • Rake: ${Math.round(RAKE * 100)}%` })
        .setTimestamp();
      return message.reply({ embeds: [statsEmbed] });
    }

    // --- Juegos ---
    if (['coinflip', 'slots', 'crash'].includes(sub)) {
      // Enviar mensaje inicial y editarlo después
      const sent = await message.reply('⏳ Procesando...');
      let fakeInteraction;
      if (sub === 'coinflip') {
        const bet = parseInt(args[1], 10);
        const pick = (args[2] || '').toLowerCase();
        if (isNaN(bet) || bet < MIN_BET || bet > MAX_BET) {
          return sent.edit(`❌ Apuesta permitida: ${MIN_BET}–${MAX_BET}.`);
        }
        if (!['cara', 'cruz'].includes(pick)) {
          return sent.edit('❌ Debes elegir "cara" o "cruz".');
        }
        fakeInteraction = {
          guildId: message.guild.id,
          user: message.author,
          options: {
            getSubcommand: () => 'coinflip',
            getInteger: () => bet,
            getString: () => pick,
          },
          deferReply: async () => {},
          editReply: async (data) => sent.edit(data),
          reply: async (data) => sent.edit(data),
        };
      }
      if (sub === 'slots') {
        const bet = parseInt(args[1], 10);
        if (isNaN(bet) || bet < MIN_BET || bet > MAX_BET) {
          return sent.edit(`❌ Apuesta permitida: ${MIN_BET}–${MAX_BET}.`);
        }
        fakeInteraction = {
          guildId: message.guild.id,
          user: message.author,
          options: {
            getSubcommand: () => 'slots',
            getInteger: () => bet,
          },
          deferReply: async () => {},
          editReply: async (data) => sent.edit(data),
          reply: async (data) => sent.edit(data),
        };
      }
      if (sub === 'crash') {
        const bet = parseInt(args[1], 10);
        const objetivo = parseFloat(args[2]);
        if (isNaN(bet) || bet < MIN_BET || bet > MAX_BET) {
          return sent.edit(`❌ Apuesta permitida: ${MIN_BET}–${MAX_BET}.`);
        }
        if (isNaN(objetivo) || objetivo < 1.01 || objetivo > 100) {
          return sent.edit('❌ Objetivo debe ser un número entre 1.01 y 100.');
        }
        fakeInteraction = {
          guildId: message.guild.id,
          user: message.author,
          options: {
            getSubcommand: () => 'crash',
            getInteger: () => bet,
            getNumber: () => objetivo,
          },
          deferReply: async () => {},
          editReply: async (data) => sent.edit(data),
          reply: async (data) => sent.edit(data),
        };
      }
      return module.exports.execute(fakeInteraction);
    }

    // Ayuda
    return message.reply('❌ Uso: &gamble [coinflip <apuesta> <cara|cruz> | slots <apuesta> | crash <apuesta> <objetivo> | stats [@usuario]]');
  }
};