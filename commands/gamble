const DAILY_LOSS_CAP = 100_000; // límite de pérdidas por día
const RAKE = 0.03; // 3% comisión sobre ganancias

function todayUtcDay() {
  return Math.floor(Date.now() / 86400000);
}

function canBet(u, amount) {
  const day = todayUtcDay();
  if (!u.gambleStats) u.gambleStats = { lastAt: 0, day, lossesToday: 0, wins: 0, losses: 0 };
  if (u.gambleStats.day !== day) { u.gambleStats.day = day; u.gambleStats.lossesToday = 0; }
  return DAILY_LOSS_CAP - (u.gambleStats.lossesToday || 0) >= amount;
}

