TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# --- Pagos (Stripe). Sin estas variables los pagos quedan desactivados. ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_LINK_SECRET=<mínimo 32 caracteres aleatorios>
# PUBLIC_BASE_URL=https://pay.tudominio.com   (HTTPS; en pruebas locales http://localhost:3000)
# PAYMENT_BRAND_NAME=Yujin
# PAYMENT_REFUND_POLICY=Texto de tu política de reembolsos
# PAYMENT_TRUST_PROXY_HOPS=1   (nº de proxies de confianza delante del bot, p. ej. Azure; 0 si no hay)
